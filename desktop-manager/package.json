{
  "name": "krishna-decor-manager-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "src/main.cjs",
  "scripts": {
    "build:manager": "node scripts/build-manager.mjs",
    "test": "node scripts/test-backup-service.cjs",
    "start": "npm run build:manager && electron .",
    "dist:win": "npm run build:manager && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "in.krishnadecor.manager",
    "productName": "Krishna Decor Manager",
    "artifactName": "Krishna-Decor-Manager-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../manager-app/dist",
        "to": "manager-app"
      },
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "**/*",
          "!data/backups/**",
          "!node_modules/**"
        ]
      },
      {
        "from": "resources/cloudflared.exe",
        "to": "cloudflared.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Krishna-Decor-Manager-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Krishna-Decor-Manager-Portable-${version}.${ext}"
    }
  }
}
